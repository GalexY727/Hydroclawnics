# Default public/local demo mode. No hosted inference or API key required.
LLM_PROVIDER=none
DEMO_MODE=true
DEMO_AUTOSTART_AGENTS=true

# Agent cadence.
TABLE_INTERVAL_S=20
SUPERVISOR_INTERVAL_S=60

# Backend and simulator.
BACKEND_URL=http://localhost:8000
PODS_PER_TABLE=100
HARDWARE_MODE=false

# Local Ollama mode:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# TABLE_AGENT_MODEL=qwen3:8b
# SUPERVISOR_MODEL=qwen3:8b
# LLM_ENABLE_THINKING=false

# Optional NVIDIA hosted mode:
# LLM_PROVIDER=nvidia
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# NVIDIA_API_KEY=nvapi-...
# TABLE_AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
# SUPERVISOR_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_ENABLE_THINKING=false
